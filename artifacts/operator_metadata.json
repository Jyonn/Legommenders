{
  "operators": [
    {
      "className": "CNNOperator",
      "contract": {
        "branchOutputShapes": {
          "history": "tensor[B, L, hidden_size]",
          "negative": "tensor[B, K, hidden_size]",
          "positive": "tensor[B, 1, hidden_size]"
        },
        "inputShape": "dict[col -> tensor[N, Lc, input_dim]]",
        "maskShape": "dict[col -> tensor[N, Lc]]",
        "outputDimPolicy": "config.hidden_size",
        "outputKind": "vector",
        "outputShape": "tensor[N, hidden_size]"
      },
      "defaults": {
        "additive_hidden_size": 256,
        "dropout": 0.1,
        "kernel_size": 3
      },
      "displayName": "CNN Content Encoder",
      "explain": "Encodes multi-column token content with Conv1d and additive attention.",
      "flags": {
        "allowCaching": true,
        "flattenMode": false
      },
      "id": "CNN",
      "inputer": {
        "className": "SimpleInputer",
        "outputSingleSequence": false
      },
      "kind": "operator",
      "notes": [
        "When used as an item operator, the same encoder is applied per clicked, positive, and negative item."
      ],
      "params": [
        {
          "default": 3,
          "description": "Conv1d window size for token sequences.",
          "key": "kernel_size",
          "label": "kernel_size",
          "min": 1,
          "step": 1,
          "type": "number"
        },
        {
          "default": 0.1,
          "description": "Dropout after convolution activation.",
          "key": "dropout",
          "label": "dropout",
          "max": 0.9,
          "min": 0,
          "step": 0.05,
          "type": "number"
        },
        {
          "default": 256,
          "description": "Hidden size used inside additive attention.",
          "key": "additive_hidden_size",
          "label": "additive_hidden_size",
          "min": 16,
          "step": 8,
          "type": "number"
        }
      ],
      "roles": [
        "item",
        "user"
      ],
      "warnings": []
    },
    {
      "className": "CNNCatOperator",
      "contract": {
        "inputShape": "dict[col -> tensor[N, Lc, input_dim]]",
        "maskShape": "dict[col -> tensor[N, Lc]]",
        "outputDimPolicy": "config.hidden_size * len(item_inputs)",
        "outputKind": "vector",
        "outputShape": "tensor[N, hidden_size * num_fields]"
      },
      "defaults": {
        "additive_hidden_size": 256,
        "dropout": 0.1,
        "kernel_size": 3
      },
      "displayName": "CNN Cat Encoder",
      "explain": "Runs CNN attention per field and concatenates field vectors.",
      "flags": {
        "allowCaching": true,
        "flattenMode": false
      },
      "id": "CNNCat",
      "inputer": {
        "className": "SimpleInputer",
        "outputSingleSequence": false
      },
      "kind": "operator",
      "notes": [],
      "params": [
        {
          "default": 3,
          "key": "kernel_size",
          "label": "kernel_size",
          "type": "number"
        },
        {
          "default": 0.1,
          "key": "dropout",
          "label": "dropout",
          "type": "number"
        },
        {
          "default": 256,
          "key": "additive_hidden_size",
          "label": "additive_hidden_size",
          "type": "number"
        }
      ],
      "roles": [
        "item",
        "user"
      ],
      "warnings": [
        "Output width depends on the number of configured item input fields."
      ]
    },
    {
      "className": "AttentionOperator",
      "contract": {
        "inputShape": "tensor[N, L, input_dim]",
        "maskShape": "tensor[N, L]",
        "outputDimPolicy": "config.hidden_size",
        "outputKind": "vector",
        "outputShape": "tensor[N, hidden_size]"
      },
      "defaults": {
        "additive_hidden_size": 256,
        "attention_dropout": 0.1,
        "num_attention_heads": 8
      },
      "displayName": "Multihead Attention Encoder",
      "explain": "Runs self-attention over a concatenated feature sequence, then pools with additive attention.",
      "flags": {
        "allowCaching": true,
        "flattenMode": false
      },
      "id": "Attention",
      "inputer": {
        "className": "ConcatInputer",
        "outputSingleSequence": true
      },
      "kind": "operator",
      "notes": [],
      "params": [
        {
          "default": 8,
          "description": "Number of self-attention heads.",
          "key": "num_attention_heads",
          "label": "num_attention_heads",
          "min": 1,
          "step": 1,
          "type": "number"
        },
        {
          "default": 0.1,
          "description": "Dropout inside multi-head attention.",
          "key": "attention_dropout",
          "label": "attention_dropout",
          "max": 0.9,
          "min": 0,
          "step": 0.05,
          "type": "number"
        },
        {
          "default": 256,
          "description": "Hidden size used inside additive attention pooling.",
          "key": "additive_hidden_size",
          "label": "additive_hidden_size",
          "min": 16,
          "step": 8,
          "type": "number"
        }
      ],
      "roles": [
        "item",
        "user"
      ],
      "warnings": []
    },
    {
      "className": "AdaOperator",
      "contract": {
        "inputShape": "tensor[B, L, input_dim]",
        "maskShape": "tensor[B, L]",
        "outputDimPolicy": "config.input_dim",
        "outputKind": "vector",
        "outputShape": "tensor[B, input_dim]"
      },
      "defaults": {
        "additive_hidden_size": 256
      },
      "displayName": "Additive Attention User Encoder",
      "explain": "Aggregates a click sequence into one user vector using additive attention.",
      "flags": {
        "allowCaching": true,
        "flattenMode": false
      },
      "id": "Ada",
      "inputer": {
        "className": "ConcatInputer",
        "outputSingleSequence": true
      },
      "kind": "operator",
      "notes": [],
      "params": [
        {
          "default": 256,
          "description": "Hidden size used inside additive attention.",
          "key": "additive_hidden_size",
          "label": "additive_hidden_size",
          "min": 16,
          "step": 8,
          "type": "number"
        }
      ],
      "roles": [
        "user"
      ],
      "warnings": []
    },
    {
      "className": "GRUOperator",
      "contract": {
        "inputShape": "tensor[B, L, input_dim]",
        "maskShape": "tensor[B, L]",
        "outputDimPolicy": "forward returns config.input_dim",
        "outputKind": "vector",
        "outputShape": "tensor[B, input_dim]"
      },
      "defaults": {
        "num_layers": 1
      },
      "displayName": "GRU User Encoder",
      "explain": "Encodes the click sequence with a GRU and projects the last hidden state back to input_dim.",
      "flags": {
        "allowCaching": true,
        "flattenMode": false
      },
      "id": "GRU",
      "inputer": {
        "className": "ConcatInputer",
        "outputSingleSequence": true
      },
      "kind": "operator",
      "notes": [],
      "params": [
        {
          "default": 1,
          "description": "Number of stacked GRU layers.",
          "key": "num_layers",
          "label": "num_layers",
          "min": 1,
          "step": 1,
          "type": "number"
        }
      ],
      "roles": [
        "user"
      ],
      "warnings": [
        "Runtime output_dim currently inherits BaseOperator.output_dim (hidden_size), while forward returns input_dim."
      ]
    },
    {
      "className": "PoolingOperator",
      "contract": {
        "inputShape": "dict[col -> tensor[B, Lc, input_dim]] or tensor[B, L, input_dim]",
        "maskShape": "dict[col -> tensor[B, Lc]] or tensor[B, L]",
        "outputDimPolicy": "config.input_dim unless flatten=true",
        "outputKind": "vector",
        "outputShape": "tensor[B, input_dim] or tensor[B, input_dim * num_fields]"
      },
      "defaults": {
        "flatten": false,
        "max_pooling": false
      },
      "displayName": "Pooling User Encoder",
      "explain": "Pools each input field, then averages/maxes fields or concatenates them when flatten=true.",
      "flags": {
        "allowCaching": true,
        "flattenMode": false
      },
      "id": "Pooling",
      "inputer": {
        "className": "SimpleInputer",
        "outputSingleSequence": false
      },
      "kind": "operator",
      "notes": [],
      "params": [
        {
          "default": false,
          "description": "Concatenate pooled fields instead of reducing across fields.",
          "key": "flatten",
          "label": "flatten",
          "type": "boolean"
        },
        {
          "default": false,
          "description": "Use max pooling rather than masked mean pooling.",
          "key": "max_pooling",
          "label": "max_pooling",
          "type": "boolean"
        }
      ],
      "roles": [
        "user"
      ],
      "warnings": [
        "When flatten=true, output width depends on the number of input fields and should be validated with dataset metadata."
      ]
    },
    {
      "className": "PolyAttentionOperator",
      "contract": {
        "compatiblePredictors": [
          "MINERPredictor"
        ],
        "inputShape": "tensor[B, L, input_dim]",
        "maskShape": "tensor[B, L]",
        "outputDimPolicy": "config.input_dim",
        "outputKind": "multi-interest",
        "outputShape": "tensor[B, num_context_codes, input_dim]"
      },
      "defaults": {
        "context_code_dim": 200,
        "num_context_codes": 32
      },
      "displayName": "Poly Attention User Encoder",
      "explain": "Produces multiple user-interest vectors for target-aware matching.",
      "flags": {
        "allowCaching": false,
        "flattenMode": false
      },
      "id": "PolyAttention",
      "inputer": {
        "className": "ConcatInputer",
        "outputSingleSequence": true
      },
      "kind": "operator",
      "notes": [
        "This operator disables caching because the multi-interest representation is target-aware downstream."
      ],
      "params": [
        {
          "default": 32,
          "description": "Number of interest vectors emitted for each user.",
          "key": "num_context_codes",
          "label": "num_context_codes",
          "min": 2,
          "step": 1,
          "type": "number"
        },
        {
          "default": 200,
          "description": "Internal projection width for context-code attention.",
          "key": "context_code_dim",
          "label": "context_code_dim",
          "min": 8,
          "step": 8,
          "type": "number"
        }
      ],
      "roles": [
        "user"
      ],
      "warnings": []
    },
    {
      "className": "NullSimpleOperator",
      "contract": {
        "inputShape": "dict[col -> tensor[N, Lc, input_dim]]",
