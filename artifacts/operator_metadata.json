        "outputShape": "tensor[B, K] or tensor[B]",
        "requires": [
          "user.outputDim == item.outputDim"
        ]
      },
      "defaults": {},
      "displayName": "Dot Product Predictor",
      "explain": "Scores user-item compatibility with an inner product.",
      "flags": {
        "allowMatching": true,
        "allowRanking": true,
        "keepInputDim": false
