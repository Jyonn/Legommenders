        ],
        "inputShape": "tensor[B, L, input_dim]",
        "maskShape": "tensor[B, L]",
        "outputDimPolicy": "not a plain vector",
        "outputKind": "embedding-mask",
        "outputShape": "dict{embedding: tensor[B, L, input_dim], mask: tensor[B, L]}"
