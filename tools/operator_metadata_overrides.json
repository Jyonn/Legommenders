{
  "components": {
    "AdaOperator": {
      "params": {
        "additive_hidden_size": {
          "description": "Hidden size used inside additive attention.",
          "min": 16,
          "step": 8
        }
      }
    },
    "AttentionOperator": {
      "params": {
        "additive_hidden_size": {
          "description": "Hidden size used inside additive attention pooling.",
          "min": 16,
          "step": 8
        },
        "attention_dropout": {
          "description": "Dropout inside multi-head attention.",
          "max": 0.9,
          "min": 0,
          "step": 0.05
        },
        "num_attention_heads": {
          "description": "Number of self-attention heads.",
          "min": 1,
          "step": 1
        }
      }
    },
    "CNNOperator": {
      "params": {
        "additive_hidden_size": {
          "description": "Hidden size used inside additive attention.",
          "min": 16,
          "step": 8
        },
        "dropout": {
          "description": "Dropout after convolution activation.",
          "max": 0.9,
          "min": 0,
          "step": 0.05
        },
        "kernel_size": {
          "description": "Conv1d window size for token sequences.",
          "min": 1,
          "step": 1
        }
      }
    },
    "DCNPredictor": {
      "params": {
        "cross_num": {
          "default": 3,
          "min": 1,
          "step": 1
        },
        "dnn_activations": {
          "default": "ReLU"
        },
        "dnn_batch_norm": {
          "default": false
        },
        "dnn_dropout": {
          "default": 0.1,
          "max": 0.9,
          "min": 0,
          "step": 0.05
        },
        "dnn_hidden_units": {
          "default": [1000, 1000, 1000],
          "description": "Hidden widths of the MLP."
        }
      }
    },
    "DINPredictor": {
      "params": {
        "attention_hidden_units": {
          "description": "Hidden widths of the DIN attention network."
        },
        "din_use_softmax": {
          "default": false
        },
        "dnn_activations": {
          "default": "ReLU"
        },
        "dnn_hidden_units": {
          "description": "Hidden widths of the final scoring MLP."
        }
      }
    },
    "DNNPredictor": {
      "params": {
        "dnn_activations": {
          "default": "ReLU",
          "description": "Activation used by hidden layers."
        },
        "dnn_batch_norm": {
          "default": false
        },
        "dnn_dropout": {
          "default": 0.1,
          "max": 0.9,
          "min": 0,
          "step": 0.05
        },
        "dnn_hidden_units": {
          "default": [1000, 1000, 1000],
          "description": "Hidden widths of the MLP."
        }
      }
    },
    "GRUOperator": {
      "params": {
        "num_layers": {
          "description": "Number of stacked GRU layers.",
          "min": 1,
          "step": 1
        }
      }
    },
    "MINERPredictor": {
      "params": {
        "score_type": {
          "description": "Aggregation strategy over per-interest scores.",
          "options": ["weighted", "max", "mean"],
          "type": "select"
        }
      }
    },
    "PolyAttentionOperator": {
      "params": {
        "context_code_dim": {
          "description": "Internal projection width for context-code attention.",
          "min": 8,
          "step": 8
        },
        "num_context_codes": {
          "description": "Number of interest vectors emitted for each user.",
          "min": 2,
          "step": 1
        }
      }
    }
  }
}
